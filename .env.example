# ═══════════════════════════════════════════════════════════════════════
# Ask PERA Assistant — Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════


# ───── OpenAI ─────
OPENAI_API_KEY=YOUR_SECRET_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# ───── Models (match current running backend) ─────
ANSWER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVER_LLM_QUERY_REWRITE_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1

# ───── Grounding Judge (blank = reuses ANSWER_MODEL) ─────
GROUNDING_JUDGE_MODEL=
GROUNDING_JUDGE_BASE_URL=
GROUNDING_JUDGE_API_KEY=

# ───── Base URL (used for reference open_url & download_url) ─────
BASE_URL=https://ask.pera.gop.pk
Base_URL=https://ask.pera.gop.pk

# ───── Index routing (blue/green atomic swap) ─────
INDEX_POINTER_PATH=assets/indexes/ACTIVE.json

# ───── LLM Query Rewrite (ChatGPT-assisted query refinement) ─────
RETRIEVER_LLM_QUERY_REWRITE_ENABLED=1
RETRIEVER_LLM_QUERY_REWRITE_ALWAYS=1
RETRIEVER_LLM_QUERY_REWRITE_MAX=3
RETRIEVER_DEBUG=1

# ───── Retriever (typo-resilient defaults) ─────
RETRIEVER_TOP_K=40
RETRIEVER_SIM_THRESHOLD=0.18
RETRIEVER_STRONG_SIM_THRESHOLD=0.26
RETRIEVER_MAX_CHUNKS_PER_DOC=6
RETRIEVER_MAX_DOCS_RETURNED=4
RETRIEVER_RELATIVE_DOC_SCORE_KEEP=0.80

RETRIEVER_QUERY_VARIANTS_ENABLED=1
RETRIEVER_MAX_QUERY_VARIANTS=3
RETRIEVER_MAX_QUERY_VARIANTS_WITH_SPELL=5

RETRIEVER_LEX_FALLBACK_ENABLED=1
RETRIEVER_LEX_FALLBACK_MAX=80
RETRIEVER_LEX_FALLBACK_PER_DOC=3

RETRIEVER_MIN_KEYWORD_MATCHES=2
RETRIEVER_RELAXED_MIN_KEYWORD_MATCHES=1

RETRIEVER_CRITERIA_DOC_PRIORITIZATION=1
RETRIEVER_CRITERIA_MIN_DOCS=2

# Spell correction
RETRIEVER_SPELL_CORRECTION_ENABLED=1
RETRIEVER_SPELL_MAX_TOKEN_FIXES=2
RETRIEVER_SPELL_EDIT_DISTANCE=2

# ───── Answerer (typo resilient, verifier strict) ─────
MAX_EVIDENCE_CHARS=32000

ANSWER_MIN_TOP_SCORE=0.38
HIT_MIN_SCORE=0.35
HIT_STRONG_SCORE_BYPASS=0.55
HIT_MEDIUM_SCORE_KEEP=0.48

MAX_HITS_PER_DOC_FOR_PROMPT=4
MAX_DOCS_FOR_PROMPT=4
MAX_REFS_RETURNED=8
REF_SNIPPET_CHARS=360

# ───── Index versioning ─────
EMBED_TEXT_VERSION=3
SEARCH_TEXT_VERSION=2