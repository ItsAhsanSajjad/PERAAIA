# ============================================================
# Ask PERA — example environment file
# ------------------------------------------------------------
# Copy to ".env" and fill in real values locally. NEVER commit a
# real .env. Do NOT put real secrets in THIS example file.
# ============================================================

# ── Admin authentication ────────────────────────────────────
# Email used to log in to the admin dashboard.
ADMIN_EMAIL=

# PBKDF2-HMAC-SHA256 hash of the admin password (NOT the plaintext).
# Generate one with:
#     python scripts/generate_admin_password_hash.py
# Then paste the printed value here. Format:
#     pbkdf2_sha256$<iterations>$<salt>$<hash>
# SECURITY: rotate the old hardcoded admin password immediately by
# generating a fresh hash and updating this value in your real .env.
ADMIN_PASSWORD_HASH=

# Optional: signing secret for admin session tokens. If unset, the
# server auto-generates and persists one in the ".admin_secret" file
# (already git-ignored). Set this only to share a fixed secret across
# instances.
# ADMIN_JWT_SECRET=

# ── Environment / CORS ──────────────────────────────────────
# APP_ENV controls CORS + security-header strictness.
#   development (default) → built-in localhost origins auto-allowed;
#                           "*" permitted ONLY if credentials are off.
#   production            → ONLY explicit CORS_ALLOW_ORIGINS allowed;
#                           wildcard "*" is ignored (fails closed).
APP_ENV=development

# Comma-separated allow-list of browser origins. In development these are
# ADDED to the built-in localhost defaults. In production this is the
# ONLY source of allowed origins. Example (production):
#   CORS_ALLOW_ORIGINS=https://ask.pera.gop.pk
CORS_ALLOW_ORIGINS=

# Send credentials (cookies/Authorization) on CORS requests? "1" to enable.
# Note: credentials are incompatible with wildcard "*" — if both are set,
# the wildcard is dropped in favor of the explicit allow-list.
CORS_ALLOW_CREDENTIALS=0

# ── OpenAI / LLM reliability ─────────────────────────────────
# Per-request timeout (seconds) applied to all OpenAI calls.
OPENAI_TIMEOUT_SECONDS=30
# Bounded SDK retries on transient failures (keep low).
OPENAI_MAX_RETRIES=1
# Max output tokens for the main answer generation.
OPENAI_ANSWER_MAX_TOKENS=1200
# Max output tokens for the optional refinement pass.
OPENAI_REFINE_MAX_TOKENS=600

# ── OpenAI / other config ───────────────────────────────────
# (OPENAI_API_KEY and other variables are documented elsewhere and
#  unchanged in this step. Do NOT put real keys in this example file.)

# ── Privacy-safe logging / audit (Step 5) ───────────────────
# This is a public government-facing system. By DEFAULT raw citizen
# questions and full client IP addresses are NOT written to the audit
# log — only a length and a short salted hash are stored. Enable raw
# logging only for local debugging, never in production.
#
# Allow raw citizen question text in the audit log ("1" = yes).
LOG_RAW_QUERIES=0
# Allow full client IP addresses in logs/audit ("1" = yes). When 0, the
# IP is replaced by a short salted hash ("h:....") for abuse correlation.
LOG_CLIENT_IP=0
# Salt mixed into query/IP hashes. Set a long random value in production
# so hashes cannot be brute-forced back to the raw query/IP. Leave blank
# in dev. NEVER commit a real salt to this example file.
AUDIT_HASH_SALT=
