# ═══════════════════════════════════════════════════════════════════
# Ask PERA Assistant — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
*.env
*.env.*
.env.bak*
*.env.bak*
env.txt
env.txt.*
*.secret
*.secrets
secrets.*
.admin_secret
# Keep the placeholder example committed (no real secrets inside).
!.env.example

# ── Python bytecode & caches ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ─────────────────────────────────────────
venv/
venv311/
venv312/
.venv/
env/
ENV/

# ── Node / Next.js ───────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ── FAISS index builds (regenerated on server) ───────────────────
# Keep only the active pointer; builds are rebuilt by the server.
assets/indexes/build_*/
assets/indexes/latest/

# ── Audit logs (server-side only) ────────────────────────────────
audit_logs/

# ── Scratch / debug output ───────────────────────────────────────
*.log
/tmp/
# Local debug/scratch artifacts (Step 5). These patterns target throwaway
# debug scripts and dumps only — they intentionally do NOT match the
# committed `tests/` suite or files literally named test_*.py.
debug_*.py
*_debug.json
*_debug.txt
debug_*.txt
tmp_*
ans_tmp.json
*_test_output.txt
retrieval_log.txt
.claude/
eval/
test_pdf/
q.json
r.json
r_*.json
sso_*.json
ask.json
qq.json
t.json
upload_resp.json
docs.json
d.json

# ── IDE / OS ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
